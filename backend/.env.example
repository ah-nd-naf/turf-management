# ------------------------------------------------------------------------------
# Turf Management — Environment Variables Example
# Duplicate this file as .env in the backend/ directory and adjust values.
# ------------------------------------------------------------------------------

# Security
SECRET_KEY=django-insecure-change-this-to-a-secure-random-key-in-production
DEBUG=True

# Database (PostgreSQL 18 Local)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/turf_db

# Allowed Hosts (comma-separated list without quotes or spaces)
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# CORS Allowed Origins (comma-separated list of origins for frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
